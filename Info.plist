<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>pl</string>
		<string>en</string>
		<string>fr</string>
		<string>de</string>
		<string>es</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!--
	Declares Movi as an available ("Otwórz z…" / "Open With") handler for
	the same video file types its own Open panel already accepts
	(`EditorViewModel.configureVideoPanel`: .movie/.video/.mpeg4Movie/
	.quickTimeMovie, i.e. public.movie/public.video/public.mpeg-4/
	com.apple.quicktime-movie — covers .mov, .mp4, .m4v and most other
	QuickTime-readable containers). `LSHandlerRank: Alternate` means Movi
	shows up as a choice in "Otwórz z" without claiming to be the default
	app for these types (that stays whatever it already is — usually
	QuickTime Player/another editor) — a plain, unopinionated "can also
	open this" registration, not a takeover. Picking Movi this way (or
	double-clicking a file if it's ever set as the default) is handled by
	`MoviApp`'s `.onOpenURL`, which SwiftUI routes here automatically for
	any type listed below — no `NSApplicationDelegate` needed.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Wideo</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.video</string>
				<string>public.mpeg-4</string>
				<string>com.apple.quicktime-movie</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
