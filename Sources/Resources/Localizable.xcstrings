    },
    "Bieżące wideo ma niezapisane zmiany. Co zrobić z nimi przed otwarciem nowego pliku?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das aktuelle Video enthält nicht gespeicherte Änderungen. Was soll damit geschehen, bevor eine neue Datei geöffnet wird?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current video has unsaved changes. What should happen to them before opening a new file?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vídeo actual tiene cambios sin guardar. ¿Qué quieres hacer con ellos antes de abrir un archivo nuevo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vidéo actuelle comporte des modifications non enregistrées. Que faire de ces modifications avant d'ouvrir un nouveau fichier ?"
          }
        }
      }
    },
    "Bieżące wideo ma niezapisane zmiany. Co zrobić z nimi przed zamknięciem okna?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das aktuelle Video enthält nicht gespeicherte Änderungen. Was soll damit geschehen, bevor das Fenster geschlossen wird?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current video has unsaved changes. What should happen to them before closing the window?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vídeo actual tiene cambios sin guardar. ¿Qué quieres hacer con ellos antes de cerrar la ventana?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vidéo actuelle comporte des modifications non enregistrées. Que faire de ces modifications avant de fermer la fenêtre ?"
          }
        }
      }
    },
